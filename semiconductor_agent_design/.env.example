# Cloud-first configuration template
# Copy to .env and set real secrets.

# Timescale Cloud
POSTGRES_DSN=postgresql://tsdbadmin:CHANGE_ME@<timescale-host>:<port>/tsdb?sslmode=require

# Qdrant Cloud
QDRANT_URL=https://<qdrant-endpoint>:6333
QDRANT_API_KEY=CHANGE_ME

# Neo4j Aura
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=neo4j

# Open DART
OPEN_DART_API_KEY=CHANGE_ME
# Option A) explicit stock_code->corp_code map (JSON)
DART_TARGETS_JSON={"005930":"00126380","000660":"00164779"}
# Option B) if DART_TARGETS_JSON is empty, corp_code is auto-resolved via corpCode.xml
DART_STOCK_CODES=005930,000660,042700
DART_LOOKBACK_DAYS=1
HTTP_TIMEOUT_SEC=20

TZ=Asia/Seoul

# Semiconductor tech harvest mode
TECH_HARVEST_DAYS=4
TECH_RSS_INTERVAL_MIN=30
TECH_ARXIV_INTERVAL_HOURS=6
TECH_LOOP_SLEEP_SEC=30

# arXiv PDF pipeline
ARXIV_DOWNLOAD_PDF=1
ARXIV_MAX_PDF_PER_RUN=25
ARXIV_PDF_DIR=data/raw/arxiv
ARXIV_CHUNK_SIZE=1500
ARXIV_CHUNK_OVERLAP=200
ARXIV_FORCE_RECHUNK=0

ARXIV_ENABLE_OCR=1
ARXIV_ASSET_DIR=data/raw/arxiv_assets


# Optional (Windows) e.g. C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=


# Semiconductor paper focus rules
ARXIV_SEMI_MIN_SCORE=0.55
ARXIV_YEAR_MIN=2023
ARXIV_YEAR_MAX=


ARXIV_BATCH_INGEST_CAP=20

# ── 기술 지식 레이어 (knowledge_collector) ──────────────────────────────────
# 청크 크기 (기본 1500자 / 오버랩 200)
KNOWLEDGE_CHUNK_SIZE=1500
KNOWLEDGE_CHUNK_OVERLAP=200

# 임베딩 후 Qdrant 업서트 활성화 여부
KNOWLEDGE_ENABLE_EMBED=1

# IRDS 대상 연도 (기본: 최신 에디션)
IRDS_TARGET_YEAR=2024

# ── 임베딩 모델 설정 ────────────────────────────────────────────────────────
# OpenAI API key 있으면 text-embedding-3-small (1536 dim) 자동 사용
# 없으면 sentence-transformers 로컬 모델 사용 (무료)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# sentence-transformers 사용 시 (OPENAI_API_KEY 없을 때)
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIM=384
EMBED_BATCH_SIZE=32

