# ═══════════════════════════════════════════════════════════════
# All_Agent 통합 환경변수
# 이 파일을 .env로 복사하고 실제 키를 입력하세요.
#   copy .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── 공통 (LLM) ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Search Agent (뉴스/공시) ─────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=
GOOGLE_API_KEY=

# ── Economy Agent (거시경제) ─────────────────────────────────
ECOS_API_KEY=
FRED_API_KEY=
CHROMA_PERSIST_DIR=./economy_agent/data/chroma_db
TIMESCALE_DSN=
FIRECRAWL_API_KEY=
CUSTOMS_API_KEY=

# ── Semiconductor Agent (반도체 기술) ────────────────────────
POSTGRES_DSN=postgresql://sema:sema_pass@localhost:5432/sema_db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
OPEN_DART_API_KEY=

# ── 기타 ─────────────────────────────────────────────────────
TZ=Asia/Seoul
